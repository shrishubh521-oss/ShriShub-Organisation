@import "tailwindcss";

:root {
  --background: #020817;
  --foreground: #f8fafc;
  --muted: #94a3b8;
  --card: rgba(15, 23, 42, 0.82);
  --line: rgba(148, 163, 184, 0.18);
  --brand: #facc15;
  --brand-dark: #ca8a04;
  --brand-soft: rgba(250, 204, 21, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at top, rgba(250, 204, 21, 0.15), transparent 28%),
    var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

main {
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

.container-page {
  width: min(1140px, calc(100% - 32px));
  margin: 0 auto;
}

.card {
  border: 1px solid var(--line);
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.8));
  box-shadow: 0 24px 80px rgba(15, 23, 42, 0.38);
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 14px;
  background: var(--brand);
  color: #111827;
  padding: 13px 18px;
  font-weight: 800;
  transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 12px 30px rgba(250, 204, 21, 0.2);
}

.btn-primary:hover {
  transform: translateY(-1px);
  opacity: 0.96;
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 13px 18px;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.02);
  color: var(--foreground);
}

.input {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.9);
  color: white;
  padding: 12px 14px;
  outline: none;
}

.input:focus {
  border-color: rgba(250, 204, 21, 0.85);
  box-shadow: 0 0 0 3px rgba(250, 204, 21, 0.08);
}

.muted {
  color: var(--muted);
}
